{
  "name": "WORKSTATION-BAR",
  "version": "3.1.0",
  "description": "NOCTURNE RED TEAM — restored WORKSTATION status bar with authorized assets",
  "widgets": [
    {
      "name": "with-glazewm",
      "htmlPath": "./with-glazewm.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "48px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ],
      "includeFiles": [
        "with-glazewm.html",
        "styles.css"
      ]
    }
  ]
}
